# Copy this file to .env only if you want to change the settings below. .env is git-ignored.
# Credentials do NOT belong here: double-click set-credentials.bat instead, which stores
# them encrypted for your Windows user under data/.

MYCITYGRID_BASE_URL=https://www.mycitygrid.com

# Optional overrides.
LOCAL_TZ=Asia/Jerusalem
HOST=127.0.0.1
PORT=8123
# DB_PATH=data/consumption.sqlite
# How often the scheduler checks whether a job is due, in seconds.
TICK_SECONDS=300
