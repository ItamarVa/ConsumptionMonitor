# Copy this file to .env and fill in the credentials. .env is git-ignored.

MYCITYGRID_USERNAME=
MYCITYGRID_PASSWORD=
MYCITYGRID_BASE_URL=https://www.mycitygrid.com

# Optional overrides.
LOCAL_TZ=Asia/Jerusalem
HOST=127.0.0.1
PORT=8123
# DB_PATH=data/consumption.sqlite
# How often the scheduler checks whether a job is due, in seconds.
TICK_SECONDS=300
